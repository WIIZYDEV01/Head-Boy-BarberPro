# Copy this file to .env.local for local development.
# Never commit real secrets. Values below are placeholders only.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon / publishable key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# service_role key (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# Required for Paystack webhooks and admin user lookup by email.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Cloud OAuth Web client ID (public). Used for Continue with Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Also paste this Client ID + Client secret in Supabase → Authentication → Providers → Google.

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Public key is used client-side only to identify the merchant; charges are
# initialized and verified on the server with the secret key.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Optional: if unset, PAYSTACK_SECRET_KEY is used to HMAC-verify webhooks.
PAYSTACK_WEBHOOK_SECRET=

# Optional: comma-separated emails granted platform admin on first profile insert.
# Set this in Supabase as well if you change it after migration.
# PLATFORM_ADMIN_EMAILS=you@example.com
